#!/usr/bin/env bash
{ set +x; } 2>/dev/null

[[ $# != 1 ]] && echo "usage: $0 path" && exit 1

export AIDER_CHECK_UPDATE=false
export ANSWER_FILE="${1%.md}_answer.md"
export STDERR_FILE="${1%/*}/stderr.log"
export FILELIST="${1%/*}/input.filelist"

[ -z "${AIDER_MODEL}" ] && echo "ERROR: AIDER_MODEL must be defined" && exit 1
! [ -e "${FILELIST}" ] && echo "ERROR: ${FILELIST} not found" && exit 1

mapfile -t FILE_ARGS < <(sed '/^$/q' "${FILELIST}" | grep -v '^$')

READ_ARGS=()
for file in "${FILE_ARGS[@]}"; do
  READ_ARGS+=(--read "$file")
done

( set -x; prompt-build "$1" ) &> /dev/null || exit
( set -x; nohup aider \
  --chat-mode ask \
  --model "${AIDER_MODEL}" \
  --light-mode \
  --map-tokens 0 \
  --no-analytics \
  --no-auto-commits \
  --no-dry-run \
  --no-notifications \
  --no-pretty \
  --no-stream \
  --weak-model none \
  "${READ_ARGS[@]}" \
  --message-file "$1" </dev/null ) > "${ANSWER_FILE}" 2> "${STDERR_FILE}" || exit
perl -0777 -pi -e 's/Added\s+.*?\s+to\s+the\s+chat\s+\(read-only\)\.//gs; s/\(read-only\)\.//gs; s/Aider v\d+\.\d+\.\d+//g; s/(Main|Weak) model:\s*\S*//gi; s/Git repo:\s*.*?\n//gi; s/Repo-map:\s*\S*//gi; s/^\s*\n//mg' "${ANSWER_FILE}"
( set -x; cat "${ANSWER_FILE}" )
