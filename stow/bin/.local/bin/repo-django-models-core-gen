#!/usr/bin/env bash
{ set +x; } 2>/dev/null

! [ -d python/packages ] && echo "ERROR: ${PWD}/python/packages/ not exists" && exit 1
! [ -d sql ] && echo "ERROR: ${PWD}/sql/ not exists" && exit 1

set -a; . local.env || exit
export DJANGO_DATABASE_URL=postgres://postgres:@127.0.0.1:5433/codegen_local
export PGSERVICEFILE=~/.pg_service.local.conf
export PGPASSFILE="$HOME/.pgpass"
export PGOPTIONS="--client-min-messages=warning"

! [ -e "$PGPASSFILE" ] && echo "ERROR: $PGPASSFILE not exists" && exit 1
! [ -e "$PGSERVICEFILE" ] && echo "ERROR: $PGSERVICEFILE not exists" && exit 1

( set -x; python -m repo_sql_partition_clean ) || exit
( set -x; python -m repo_sql_partition_gen ) || exit
( set -x; PGSERVICE=codegen_local dropdb -f codegen_local ) || exit
( set -x; PGSERVICE=codegen_local createdb codegen_local ) || exit
for attempt in {1..10}; do
    success=true
    while read -r sql_file; do
        psql -v ON_ERROR_STOP=1 -d "service=codegen_local" -f "$sql_file" &> /dev/null || success=false
    done < <(find sql/src -name "*.sql" -type f | grep -vi partition)
done
[[ $success == false ]] && {
    while read -r sql_file; do
        echo "$sql_file"
        psql -v ON_ERROR_STOP=1 -d "service=codegen_local" -f "$sql_file" 1>/dev/null || exit
    done < <(find sql/src -name "*.sql" -type f | grep -vi partition)
}
( set -x; python -m repo_django_models_clean ) || exit
( set -x; .venv/bin/python -m repo_django_models_gen ) || exit
while read -r init_dir; do
    ( set -x; .venv/bin/python -m python_init_py_class_imports_gen "$init_dir" ) || exit
done < <(find python/packages -name "models" -type d -mindepth 3 -maxdepth 3)

( set -x; repo-python-packages-black ) || exit
( set -x; repo-python-packages-isort ) || exit
