#!/usr/bin/env bash
{ set +x; } 2>/dev/null

export PGSERVICEFILE=~/.pg_service.local.conf
export PGPASSFILE="$HOME/.pgpass"
export PGOPTIONS="--client-min-messages=warning"

! [ -e "$PGPASSFILE" ] && echo "ERROR: $PGPASSFILE not exists" && exit 1
! [ -e "$PGSERVICEFILE" ] && echo "ERROR: $PGSERVICEFILE not exists" && exit 1

( set -x; PGSERVICE=codegen_local dropdb -f codegen_local ) || exit
( set -x; PGSERVICE=codegen_local createdb codegen_local ) || exit

for attempt in {1..10}; do
    success=true
    while read -r sql_file; do
        psql -v ON_ERROR_STOP=1 -d "service=codegen_local" -f "$sql_file" &> /dev/null || success=false
    done < <(find sql/src -name "*.sql" -type f | grep -vi partition)
done
[[ $success == true ]] && exit
while read -r sql_file; do
    echo "$sql_file"
    psql -v ON_ERROR_STOP=1 -d "service=codegen_local" -f "$sql_file" 1>/dev/null || exit
done < <(find sql/src -name "*.sql" -type f | grep -vi partition)

