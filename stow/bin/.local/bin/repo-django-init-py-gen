#!/usr/bin/env bash
{ set +x; } 2>/dev/null

! [ -d python/packages ] && echo "ERROR: ${PWD}/python/packages/ not exists" && exit 1

set -a; . local.env || exit;

while read -r pkg; do
    ( set -x; .venv/bin/python -m repo_django_package_inits_gen "$pkg" ) || exit
done < <(find python/packages -mindepth 1 -maxdepth 1 -type d -name)

( set -x; repo-python-packages-black ) || exit
( set -x; repo-python-packages-isort ) || exit
