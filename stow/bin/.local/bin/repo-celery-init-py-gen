#!/usr/bin/env bash
{ set +x; } 2>/dev/null

! [ -d python/packages ] && echo "ERROR: ${PWD}/python/packages/ not exists" && exit 1

set -a; . local.env || exit;

while read -r pkg; do
    ( set -x; .venv/bin/python -m celery_package_init_py_gen "$pkg" ) || exit
done < <(find python/packages -type d -name "*_tasks" -mindepth 1 -maxdepth 1) || exit
