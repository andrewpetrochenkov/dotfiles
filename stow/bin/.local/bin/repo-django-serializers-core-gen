#!/usr/bin/env bash
{ set +x; } 2>/dev/null

! [ -d python/packages ] && echo "ERROR: ${PWD}/python/packages/ not exists" && exit 1

set -a; . local.env || exit;

while read -r pkg; do
    ( set -x; python -m django_package_serializers_clean "$pkg" ) || exit
    ( set -x; .venv/bin/python -m django_package_serializers_gen "$pkg" ) || exit
done < <(find python/packages -mindepth 1 -maxdepth 1 -type d)

while read -r init_dir; do
    ( set -x; .venv/bin/python -m python_init_py_class_imports_gen "$init_dir" ) || exit
done < <(find python/packages -mindepth 1 -maxdepth 1 -type d | grep -vE '(_contracts|_env|_tasks)$')
