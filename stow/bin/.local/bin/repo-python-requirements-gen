#!/usr/bin/env bash
{ set +x; } 2>/dev/null

! [ -d python/packages ] && echo "ERROR: ${PWD}/python/packages/ not exists" && exit 1

( set -x; python3.14 -m pipreqs.pipreqs --force --use-local --savepath python/requirements.txt --ignore $(ls -d python/.external_packages/* python/packages/* 2>/dev/null | paste -sd, -) python ) || exit
( set -x; cat python/requirements.txt )
