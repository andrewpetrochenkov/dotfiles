#!/usr/bin/env bash
{ set +x; } 2>/dev/null

export MODEL="openai/qwen3-coder"
export AIDER_LOAD_FILE=$(mktemp)
export PROMPT_FILE=~/git/ai-prompts/prompts/python/django/models_generator.md
source "$HOME/.secrets.env" || exit

! [ -d python/packages ] && echo "ERROR: ${PWD}/python/packages/ not exists" && exit 1
! [ -e "${PROMPT_FILE}" ] && echo "ERROR: ${PROMPT_FILE} not exists" && exit 1

( set -x; python -m python_packages_django_models_aider_mapper | tee "$AIDER_LOAD_FILE"; exit ${PIPESTATUS[0]} )
[ $? -eq 0 ] && [ -s "$AIDER_LOAD_FILE" ] || exit $?

( set -x; git init && git add . ) || exit
( set -x; aider \
  --model "$MODEL" \
  --load "$AIDER_LOAD_FILE" \
  --message-file "${PROMPT_FILE}"
) || exit
( set -x; git add . )
