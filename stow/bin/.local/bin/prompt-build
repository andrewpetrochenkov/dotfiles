#!/usr/bin/env bash
{ set +x; } 2>/dev/null

[[ $# != 1 ]] && echo "usage: $0 path" && exit 1

export AIDER_DISABLE_UPDATE_CHECK=1

( set -x; python3 -m prompt_context_find "$1" > "${1%/*}/input.filelist" ) || exit
echo "" >> "${1%/*}/input.filelist" || exit
( set -x; cat "${1%/*}/input.filelist" | xargs -t python3 -m tree_print ) >> "${1%/*}/input.filelist" || exit

