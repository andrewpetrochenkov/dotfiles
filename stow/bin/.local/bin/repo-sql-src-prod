#!/usr/bin/env bash
{ set +x; } 2>/dev/null

export PGSERVICEFILE=~/.config/postgresql/pg_service.prod.conf
export PGPASSFILE=~/.config/postgresql/pgpass
export PGOPTIONS="--client-min-messages=warning"

. .env.prod || exit 1
[[ -z $PGDATABASE ]] && echo "ERROR: .env.prod PGDATABASE not defined" && exit 1
! [ -e "$PGPASSFILE" ] && echo "ERROR: $PGPASSFILE not exists" && exit 1
! [ -e "$PGSERVICEFILE" ] && echo "ERROR: $PGSERVICEFILE not exists" && exit 1

out=$(psql -d "service=$PGDATABASE" -c "SELECT 1") || exit 1
[[ -z "$out" ]] && echo "ERROR: empty output for service=$PGDATABASE" && exit 1

for attempt in {1..10}; do
    success=true

    while read -r file_path; do
        psql -v ON_ERROR_STOP=1 -d "service=$PGDATABASE" -f "$file_path" &>/dev/null || success=false
    done < <(find sql/src -name "*.sql" -type f)

    [[ "$success" = true ]] && exit 0
done
while read -r file_path; do
    echo "$file_path"
    psql -v ON_ERROR_STOP=1 -d "service=$PGDATABASE" -f "$file_path" 1>/dev/null || exit
done < <(find sql/src -name "*.sql" -type f);:

