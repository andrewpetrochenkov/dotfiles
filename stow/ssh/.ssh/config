Include config.d/*
Host *
  AddKeysToAgent yes
  UseKeychain yes
  IdentityFile ~/.ssh/id_rsa

# ====================================================================
# GLOBAL DEFAULTS (MUST BE PLACED AT THE ABSOLUTE BOTTOM)
# ====================================================================

Host *
    # Non-interactive automation (prevents script hangs)
    StrictHostKeyChecking no
    UserKnownHostsFile /dev/null
    LogLevel ERROR

    # Strip local environment pollution
    SendEnv -*

    # Connection timeout (fixed syntax, removed '=')
    ConnectTimeout 3

    # Keep-alive (fixes "freeze" bug on Wi-Fi drops / sleep)
    ServerAliveInterval 15
    ServerAliveCountMax 3

    # Multiplexing (forces multiple sessions over 1 TCP pipe)
    ControlMaster auto

    # Safe socket directory (fixes macOS /tmp cleanup issues)
    ControlPath ~/.ssh/sockets/%r@%h:%p

    # Keep master socket open in background for 2 hours
    ControlPersist 2h

    # Dynamic project inclusions
    Include config.d/*
    Include config.d/*/*
